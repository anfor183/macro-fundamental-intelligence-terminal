# Environment Configuration for Macro Fundamental Intelligence Platform
ENVIRONMENT=development
DEMO_MODE=true

# Database (defaults to zero-setup async SQLite, or configure PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./backend/data/macro_platform.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/macro_db

# Cache & Queues (Optional; in-memory fallback enabled by default)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=false

# External APIs (Optional; platform operates with fallback public RSS feeds and synthetic scenarios)
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
FINANCIAL_NEWS_API_KEY=
FRED_API_KEY=

# Ingestion & Polling
POLL_INTERVAL_SECONDS=300
ENABLE_LIVE_POLLING=true

# Server & Security
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=UTC
